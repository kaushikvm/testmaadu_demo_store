{
  "openapi": "3.0.3",
  "info": {
    "title": "OnlineMart demo store API",
    "version": "1.0.0",
    "description": "REST API behind the OnlineMart demo store (created by TestMaadu.in). Use it to practise API testing.\n\nSign in with POST /auth/login (demo@testmaadu.in / Demo@123), then send `Authorization: Bearer <token>`.\n\nOrders are kept in memory and can reset when the server restarts."
  },
  "servers": [
    {
      "url": "/api",
      "description": "This server"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Catalog"
    },
    {
      "name": "Cart"
    },
    {
      "name": "Checkout"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Profile"
    },
    {
      "name": "Health"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in and get a bearer token",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "demo@testmaadu.in",
                "password": "Demo@123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "List categories",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "Category names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": [
                  "Electronics",
                  "Fashion",
                  "Home",
                  "Books",
                  "Sports"
                ]
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Search and filter products",
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Text search in name and description",
            "example": "head"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "All",
                "Electronics",
                "Fashion",
                "Home",
                "Books",
                "Sports"
              ]
            }
          },
          {
            "name": "inStock",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "freeDelivery",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "price-asc",
                "price-desc",
                "rating"
              ],
              "default": "popular"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{productId}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Get one product",
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "P101"
          }
        ],
        "responses": {
          "200": {
            "description": "The product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Unknown product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cart/quote": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Price a cart (subtotal, coupon, delivery, GST)",
        "operationId": "quoteCart",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartRequest"
              },
              "example": {
                "items": [
                  {
                    "productId": "P101",
                    "qty": 1
                  },
                  {
                    "productId": "P110",
                    "qty": 2
                  }
                ],
                "coupon": "TESTMAADU10",
                "delivery": "standard"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Priced cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "description": "Empty cart or bad quantity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Not enough stock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid coupon",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/checkout": {
      "post": {
        "tags": [
          "Checkout"
        ],
        "summary": "Pay and place an order",
        "operationId": "checkout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              },
              "example": {
                "items": [
                  {
                    "productId": "P101",
                    "qty": 1
                  },
                  {
                    "productId": "P110",
                    "qty": 1
                  }
                ],
                "coupon": "",
                "delivery": "standard",
                "giftWrap": false,
                "address": {
                  "fullName": "Demo Tester",
                  "phone": "9876543210",
                  "line1": "12 MG Road",
                  "line2": "",
                  "city": "Bengaluru",
                  "state": "Karnataka",
                  "pincode": "560001"
                },
                "payment": {
                  "method": "card",
                  "cardLast4": "1111"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order placed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Bad JSON or empty cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Payment failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Not enough stock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (address, payment, coupon)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List my orders",
        "operationId": "listOrders",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Orders, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get one order",
        "operationId": "getOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "OM-20261014-12345"
          }
        ],
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get my profile",
        "operationId": "getProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Update my profile",
        "operationId": "updateProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              },
              "example": {
                "name": "Demo Tester",
                "phone": "9876543210",
                "country": "India",
                "gender": "Prefer not to say",
                "deliverySlot": "evening",
                "notifications": {
                  "orderUpdates": true,
                  "offers": true,
                  "newsletter": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid name or phone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token from POST /auth/login"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "UNAUTHORIZED"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PaymentError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "PAYMENT_FAILED"
          },
          "message": {
            "type": "string"
          },
          "gatewayCode": {
            "type": "string",
            "example": "GW-5001"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "example": "INR"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/Profile"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "P101"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "mrp": {
            "type": "number"
          },
          "rating": {
            "type": "number"
          },
          "reviews": {
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          },
          "freeDelivery": {
            "type": "boolean"
          },
          "emoji": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "required": [
          "productId",
          "qty"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "example": "P101"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "CartRequest": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "coupon": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "standard",
              "express"
            ]
          }
        }
      },
      "QuoteLine": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "qty": {
            "type": "integer"
          },
          "lineTotal": {
            "type": "number"
          }
        }
      },
      "Quote": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteLine"
            }
          },
          "itemCount": {
            "type": "integer"
          },
          "subtotal": {
            "type": "number"
          },
          "discount": {
            "type": "number"
          },
          "shipping": {
            "type": "number"
          },
          "tax": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "coupon": {
            "type": "object",
            "nullable": true,
            "properties": {
              "code": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "fullName",
          "phone",
          "line1",
          "city",
          "state",
          "pincode"
        ],
        "properties": {
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "pincode": {
            "type": "string",
            "pattern": "^[1-9][0-9]{5}$"
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "card",
              "upi",
              "cod"
            ]
          },
          "cardLast4": {
            "type": "string",
            "example": "1111"
          },
          "upiId": {
            "type": "string",
            "example": "demo@okbank"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "items",
          "address",
          "payment"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "coupon": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "standard",
              "express"
            ]
          },
          "giftWrap": {
            "type": "boolean"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "payment": {
            "$ref": "#/components/schemas/Payment"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "OM-20261014-12345"
          },
          "status": {
            "type": "string",
            "example": "Confirmed"
          },
          "placedAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteLine"
            }
          },
          "itemCount": {
            "type": "integer"
          },
          "totals": {
            "type": "object",
            "properties": {
              "subtotal": {
                "type": "number"
              },
              "discount": {
                "type": "number"
              },
              "shipping": {
                "type": "number"
              },
              "tax": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              }
            }
          },
          "delivery": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "payment": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "cardLast4": {
                "type": "string"
              },
              "upiId": {
                "type": "string"
              },
              "transactionId": {
                "type": "string"
              }
            }
          },
          "giftWrap": {
            "type": "boolean"
          },
          "estimatedDelivery": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "deliverySlot": {
            "type": "string",
            "enum": [
              "anytime",
              "morning",
              "evening"
            ]
          },
          "notifications": {
            "type": "object",
            "properties": {
              "orderUpdates": {
                "type": "boolean"
              },
              "offers": {
